{% set completed = data|filter(step => step.done)|length %}
{% if completed < data|length %}
    {% set title = options.title|default(title|default('onboarding.title')) %}
    {% embed '@theme/embeds/card.html.twig' with {'border': false, 'margin_bottom': 0} %}
        {% block box_title %}{{ title|trans }}{% endblock %}
        {% block box_body %}
            <p class="text-secondary">{{ 'onboarding.progress'|trans({'%completed%': completed, '%total%': data|length}) }}</p>
            <ul class="list-unstyled mb-0">
                {% for step in data %}
                    {% set canAccess = false %}
                    {% if step.key in ['customer', 'project', 'activity'] %}
                        {% set canAccess = is_granted('listing', step.key) %}
                    {% elseif step.key == 'timesheet' %}
                        {% set canAccess = is_granted('view_own_timesheet') %}
                    {% elseif step.key == 'colleague' %}
                        {% set canAccess = is_granted('view_user') %}
                    {% endif %}
                    <li class="mb-2">
                        <i class="{{ step.done ? 'fa-solid fa-circle-check text-success' : 'fa-regular fa-circle text-secondary' }} me-2" aria-hidden="true"></i>
                        <span class="visually-hidden">{{ (step.done ? 'onboarding.done' : 'onboarding.pending')|trans }}</span>
                        {% if canAccess %}
                            <a href="{{ path(step.route) }}">{{ ('onboarding.step.' ~ step.key)|trans }}</a>
                        {% else %}
                            <span>{{ ('onboarding.step.' ~ step.key)|trans }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}
{% endif %}
