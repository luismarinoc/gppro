<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'quotation.view_title'|trans }} #{{ quotation.id }}</title>
    <style>
        body { font-family: sans-serif; font-size: 11pt; color: #222; }
        .quotation-logo { max-height: 46px; max-width: 260px; margin-bottom: 6px; display: block; }
        .doc-header { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
        .doc-header td { padding: 0; border: 0; vertical-align: top; }
        .doc-header .doc-issuer-cell { width: 60%; }
        .doc-issuer-name { margin: 0; font-size: 13pt; font-weight: bold; text-transform: uppercase; color: #183870; }
        .doc-meta { width: 40%; text-align: right; }
        .doc-type { margin: 0 0 4px; font-size: 22pt; font-weight: bold; text-transform: uppercase; color: #183870; }
        .doc-meta p { margin: 2px 0; color: #555; font-size: 10pt; }
        .doc-meta strong { color: #222; }
        .doc-accent-bar { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
        .doc-accent-bar td { padding: 0; border: 0; height: 3px; line-height: 3px; font-size: 1px; }
        .doc-accent-bar td:nth-child(1) { background: #183870; }
        .doc-accent-bar td:nth-child(2) { background: #e00830; }
        .doc-accent-bar td:nth-child(3) { background: #009038; }
        .doc-parties { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .doc-parties td { padding: 0; border: 0; width: 50%; vertical-align: top; }
        .doc-parties h4 { margin: 0 0 4px; font-size: 9.5pt; text-transform: uppercase; letter-spacing: .04em; color: #777; }
        .doc-parties p { margin: 2px 0; color: #555; }
        .doc-parties .party-name { color: #222; font-weight: bold; font-size: 11pt; margin-bottom: 3px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 7px 4px; border-bottom: 1px solid #ddd; }
        th, .number { text-align: right; }
        th:first-child, td:first-child { text-align: left; }
        thead th { background: #183870; color: #fff; border-bottom: none; }
        .doc-bottom { position: absolute; bottom: 14mm; left: 0; right: 0; }
        .summary { margin-left: auto; width: 45%; border-top: 1px solid #ddd; padding-top: 8pt; }
        .summary td { border: 0; padding: 4px; }
        .summary .total td { background: #eef2fa; color: #183870; font-weight: bold; font-size: 13pt; }
        .response-hint { margin-top: 12pt; color: #555; font-size: 9.5pt; }
        .doc-signatures { width: 100%; border-collapse: collapse; margin-top: 12pt; }
        .doc-signatures td { border: 0; padding: 0; vertical-align: bottom; }
        .doc-signatures .sign-space { padding-top: 14mm; }
        .doc-signatures .sign-gap { width: 8%; }
        .doc-signatures .sign-line { width: 46%; border-top: 1px solid #555; padding-top: 4pt; font-size: 9pt; color: #777; text-transform: uppercase; }
        .doc-signatures .sign-name { font-size: 10pt; padding-top: 2pt; }
        .doc-signatures .sign-date { font-size: 9pt; color: #555; padding-top: 6pt; }
    </style>
</head>
<body>
    {# GPartner Consulting always issues the quotation - never the customer's own billing template. #}
    {% set issuerName = config('theme.branding.company') is not empty ? config('theme.branding.company') : 'Gpartner Consulting' %}
    {% set logo = config('theme.branding.logo') is not empty ? config('theme.branding.logo') : defaultLogo %}
    {% set issuerVatId = config('theme.branding.vat_id') %}
    {% set issuerAddress = config('theme.branding.address') %}
    {% set issuerPhone = config('theme.branding.phone') %}
    {% set issuerEmail = config('theme.branding.email') %}
    {% set issuerWebsite = config('theme.branding.website') %}

    <table class="doc-header" cellpadding="0" cellspacing="0">
        <tr>
            <td class="doc-issuer-cell">
                {% if logo is not empty %}<img class="quotation-logo" src="{{ logo }}" alt="{{ issuerName }}">{% endif %}
                <p class="doc-issuer-name">{{ issuerName }}</p>
            </td>
            <td class="doc-meta">
                <p class="doc-type">{{ 'quotation.view_title'|trans }}</p>
                <p><strong>{{ 'quotation.number'|trans }}:</strong> {{ quotation.id }}</p>
                <p><strong>{{ 'quotation.issue_date'|trans }}:</strong> {{ quotation.createdAt|date('d/m/Y') }}</p>
                {% if quotation.validUntil %}<p><strong>{{ 'quotation.valid_until'|trans }}:</strong> {{ quotation.validUntil|date('d/m/Y') }}</p>{% endif %}
                <p><strong>{{ 'quotation.payment_term'|trans }}:</strong> {{ quotation.paymentTermDays ? 'quotation.payment_term_days'|trans({'%days%': quotation.paymentTermDays}) : 'quotation.payment_term_placeholder'|trans }}</p>
            </td>
        </tr>
    </table>
    <table class="doc-accent-bar" cellpadding="0" cellspacing="0"><tr><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr></table>

    <table class="doc-parties" cellpadding="0" cellspacing="0">
        <tr>
            <td>
                <h4>{{ 'quotation.issuer'|trans }}</h4>
                <p class="party-name">{{ issuerName }}</p>
                {% if issuerVatId %}<p>{{ 'quotation.issuer_vat_id'|trans }}: {{ issuerVatId }}</p>{% endif %}
                {% if issuerAddress %}<p>{{ issuerAddress }}</p>{% endif %}
                {% if issuerPhone %}<p>{{ 'quotation.issuer_phone'|trans }}: {{ issuerPhone }}</p>{% endif %}
                {% if issuerEmail %}<p>{{ issuerEmail }}</p>{% endif %}
                {% if issuerWebsite %}<p>{{ issuerWebsite }}</p>{% endif %}
            </td>
            <td>
                <h4>{{ 'quotation.quoted_for'|trans }}</h4>
                <p class="party-name">{{ quotation.customer.company|default(quotation.customer.name) }}</p>
                {% if quotation.customer.vatId %}<p>{{ 'quotation.issuer_vat_id'|trans }}: {{ quotation.customer.vatId }}</p>{% endif %}
                {% if quotation.customer.formattedAddress %}<p>{{ quotation.customer.formattedAddress|nl2br }}</p>{% endif %}
                {% if quotation.customer.phone %}<p>{{ 'quotation.issuer_phone'|trans }}: {{ quotation.customer.phone }}</p>{% endif %}
                {% if quotation.customer.email %}<p>{{ quotation.customer.email }}</p>{% endif %}
                {% if quotation.project %}<p>{{ 'project'|trans }}: {{ quotation.project.name }}</p>{% endif %}
            </td>
        </tr>
    </table>

    <table>
        <thead>
            <tr>
                <th>{{ 'quotation.description'|trans }}</th>
                <th>{{ 'quotation.quantity'|trans }}</th>
                <th>{{ 'quotation.unit_price'|trans }}</th>
                <th>{{ 'quotation.line_subtotal'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for item in clpSummary.items %}
            <tr>
                <td>{{ item.description }}</td>
                <td class="number">{{ item.amount }}</td>
                <td class="number">{{ item.unitPriceClp|money('CLP') }}</td>
                <td class="number">{{ item.lineTotalClp|money('CLP') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="doc-bottom">
        <table class="summary">
            <tr><td>{{ 'quotation.subtotal'|trans }}</td><td class="number">{{ clpSummary.subtotalClp|money('CLP') }}</td></tr>
            {% if quotation.discount is not null %}<tr><td>{{ 'quotation.discount_amount'|trans }} ({{ quotation.discount + 0 }}%)</td><td class="number">-{{ clpSummary.discountAmountClp|money('CLP') }}</td></tr>{% endif %}
            {% if quotation.surcharge is not null %}<tr><td>{{ 'quotation.surcharge_amount'|trans }} ({{ quotation.surcharge + 0 }}%)</td><td class="number">{{ clpSummary.surchargeAmountClp|money('CLP') }}</td></tr>{% endif %}
            <tr><td>{{ 'quotation.adjusted_subtotal'|trans }}</td><td class="number">{{ clpSummary.adjustedSubtotalClp|money('CLP') }}</td></tr>
            {% if clpSummary.taxAmountClp is not null %}<tr><td>{{ 'quotation.tax_amount'|trans }} ({{ quotation.tax + 0 }}%)</td><td class="number">{{ clpSummary.taxAmountClp|money('CLP') }}</td></tr>{% endif %}
            <tr class="total"><td>{{ 'quotation.total'|trans }}</td><td class="number">{{ clpSummary.totalClp|money('CLP') }}</td></tr>
        </table>

        <p class="response-hint">{{ 'quotation.response_hint'|trans }}</p>

        <table class="doc-signatures" cellpadding="0" cellspacing="0">
            <tr><td class="sign-space">&nbsp;</td><td class="sign-gap">&nbsp;</td><td class="sign-space">&nbsp;</td></tr>
            <tr><td class="sign-line">{{ 'quotation.signature_issuer'|trans }}</td><td>&nbsp;</td>
                <td class="sign-line">{{ 'quotation.signature_customer'|trans }}</td></tr>
            <tr><td class="sign-name">{{ issuerName }}</td><td>&nbsp;</td>
                <td class="sign-name">{% if quotation.customer.contact %}{{ quotation.customer.contact }}{% else %}&nbsp;{% endif %}</td></tr>
            <tr><td class="sign-date">{{ 'quotation.signature_date'|trans }}: ______________</td><td>&nbsp;</td>
                <td class="sign-date">{{ 'quotation.signature_date'|trans }}: ______________</td></tr>
        </table>
    </div>
</body>
</html>
