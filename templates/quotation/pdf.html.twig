<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'quotation.view_title'|trans }} #{{ quotation.id }}</title>
    <style>
        body { font-family: sans-serif; font-size: 11pt; color: #222; }
        .quotation-logo { max-height: 60px; max-width: 260px; margin-bottom: 14px; }
        h1 { margin: 0 0 4px; font-size: 20pt; }
        .quotation-meta { margin-bottom: 20px; color: #555; }
        .quotation-meta strong { color: #222; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 7px 4px; border-bottom: 1px solid #ddd; }
        th, .number { text-align: right; }
        th:first-child, td:first-child { text-align: left; }
        thead th { border-bottom: 2px solid #222; }
        .summary { margin-top: 18px; margin-left: auto; width: 45%; }
        .summary td { border: 0; padding: 4px; }
        .summary .total td { border-top: 2px solid #222; font-weight: bold; font-size: 13pt; }
        .response-hint { margin-top: 24px; color: #555; font-size: 9.5pt; }
    </style>
</head>
<body>
    {% set invoiceTemplate = quotation.customer.invoiceTemplate %}
    {% set logo = invoiceTemplate is not null and invoiceTemplate.logo is not empty ? invoiceTemplate.logo : config('theme.branding.logo') %}
    {% if logo is not empty %}
        <img class="quotation-logo" src="{{ logo }}" alt="{{ invoiceTemplate ? invoiceTemplate.company : '' }}">
    {% endif %}

    <h1>{{ 'quotation.view_title'|trans }} #{{ quotation.id }}</h1>
    <div class="quotation-meta">
        <p><strong>{{ 'customer'|trans }}:</strong> {{ quotation.customer.name }}</p>
        {% if quotation.project %}<p><strong>{{ 'project'|trans }}:</strong> {{ quotation.project.name }}</p>{% endif %}
        {% if quotation.validUntil %}<p><strong>{{ 'quotation.valid_until'|trans }}:</strong> {{ quotation.validUntil|date('Y-m-d') }}</p>{% endif %}
    </div>

    <table>
        <thead>
            <tr>
                <th>{{ 'quotation.description'|trans }}</th>
                <th>{{ 'quotation.quantity'|trans }}</th>
                <th>{{ 'quotation.unit_price'|trans }}</th>
                <th>{{ 'quotation.line_subtotal'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.description }}</td>
                <td class="number">{{ item.amount }}</td>
                <td class="number">{{ item.fixedRate|money(currency) }}</td>
                <td class="number">{{ item.rate|money(currency) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <table class="summary">
        <tr><td>{{ 'quotation.subtotal'|trans }}</td><td class="number">{{ subtotal|money(currency) }}</td></tr>
        {% if quotation.discount is not null %}<tr><td>{{ 'quotation.discount_amount'|trans }} ({{ quotation.discount }}%)</td><td class="number">-{{ discount_amount|money(currency) }}</td></tr>{% endif %}
        {% if quotation.surcharge is not null %}<tr><td>{{ 'quotation.surcharge_amount'|trans }} ({{ quotation.surcharge }}%)</td><td class="number">{{ surcharge_amount|money(currency) }}</td></tr>{% endif %}
        <tr><td>{{ 'quotation.adjusted_subtotal'|trans }}</td><td class="number">{{ adjusted_subtotal|money(currency) }}</td></tr>
        {% if tax_amount is not null %}<tr><td>{{ 'quotation.tax_amount'|trans }} ({{ quotation.tax }}%)</td><td class="number">{{ tax_amount|money(currency) }}</td></tr>{% endif %}
        <tr class="total"><td>{{ 'quotation.total'|trans }}</td><td class="number">{{ total|money(currency) }}</td></tr>
        {% if clpConversion is not null and clpConversion.isConverted() %}
            <tr>
                <td>{{ 'quotation.clp_equivalent'|trans }}<br><small>{{ 'quotation.fx_rate_as_of'|trans({'%currency%': clpConversion.sourceCurrency == 'CLF' ? 'UF' : clpConversion.sourceCurrency, '%rate%': clpConversion.rate|number_format(2), '%date%': clpConversion.rateDate|date('Y-m-d')}) }}</small></td>
                <td class="number">≈ {{ clpConversion.clpAmount|money('CLP') }}</td>
            </tr>
        {% endif %}
    </table>

    <p class="response-hint">{{ 'quotation.response_hint'|trans }}</p>
</body>
</html>
