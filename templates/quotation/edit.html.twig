{% extends 'base.html.twig' %}

{% block main %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-lg-8">
            {% embed '@theme/embeds/card.html.twig' %}
                {% block box_title %}{{ 'quotation.general_info'|trans }}{% endblock %}
                {% block box_body %}
                    {{ form_row(form.customer) }}
                    {{ form_row(form.project) }}
                    <div class="row">
                        <div class="col-md-4">{{ form_row(form.validUntil) }}</div>
                        <div class="col-md-4">{{ form_row(form.currency) }}</div>
                        <div class="col-md-4">{{ form_row(form.paymentTermDays) }}</div>
                        <div class="col-md-4">{{ form_row(form.tax) }}</div>
                        <div class="col-md-4">{{ form_row(form.discount) }}</div>
                        <div class="col-md-4">{{ form_row(form.surcharge) }}</div>
                    </div>
                    {{ form_row(form.notes) }}
                {% endblock %}
            {% endembed %}

            {% embed '@theme/embeds/card.html.twig' %}
                {% block box_title %}{{ 'quotation.lines'|trans }}{% endblock %}
                {% block box_tools %}
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-secondary btn-sm" type="button" data-add-catalog-line>{{ icon('create', true) }} {{ 'quotation.add_catalog_line'|trans }}</button>
                        <button class="btn btn-outline-secondary btn-sm" type="button" data-add-manual-line>{{ icon('create', true) }} {{ 'quotation.add_manual_line'|trans }}</button>
                    </div>
                {% endblock %}
                {% block box_body %}
                    <p class="text-muted">{{ 'quotation.lines_help'|trans }}</p>
                    {{ form_errors(form.lines) }}
                    <template data-quotation-line-prototype>
                        <div class="quotation_line border-bottom pb-3 mb-3" data-quotation-line>
                            <div class="row g-2 align-items-end">
                                <div class="col-lg-3">{{ form_row(form.lines.vars.prototype.catalogItem) }}</div>
                                <div class="col-lg-4">{{ form_row(form.lines.vars.prototype.description) }}</div>
                                <div class="col-sm-4 col-lg-2">{{ form_row(form.lines.vars.prototype.quantity) }}</div>
                                <div class="col-sm-4 col-lg-2">{{ form_row(form.lines.vars.prototype.unitPrice) }}</div>
                                <div class="col-8 col-lg-1">
                                    <label class="form-label">{{ 'quotation.line_subtotal'|trans }}</label>
                                    <output class="form-control-plaintext fw-bold" data-line-subtotal>0.00</output>
                                </div>
                                <div class="col-4 col-lg-1 text-end">
                                    <button class="btn btn-icon btn-outline-danger" type="button" data-remove-quotation-line title="{{ 'quotation.remove_line'|trans }}">
                                        {{ icon('trash', true) }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </template>
                    <div data-quotation-lines>
                        {% for line in form.lines %}
                            {% set data = line.vars.data %}
                            <div class="quotation_line border-bottom pb-3 mb-3" data-quotation-line>
                                <div class="d-flex align-items-center justify-content-between gap-2" data-quotation-line-view>
                                    <div class="row g-2 flex-grow-1">
                                        <div class="col-lg-5" data-view-description>{{ data.description }}</div>
                                        <div class="col-lg-2 text-end" data-view-quantity>{{ data.quantity }}</div>
                                        <div class="col-lg-2 text-end" data-view-unit-price>{{ data.unitPrice|money(currency) }}</div>
                                        <div class="col-lg-2 text-end fw-bold" data-view-line-subtotal>{{ (data.quantity * data.unitPrice)|money(currency) }}</div>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-icon btn-outline-secondary" type="button" data-edit-quotation-line title="{{ 'edit'|trans }}">
                                            {{ icon('edit', true) }}
                                        </button>
                                        <button class="btn btn-icon btn-outline-danger" type="button" data-remove-quotation-line title="{{ 'quotation.remove_line'|trans }}">
                                            {{ icon('trash', true) }}
                                        </button>
                                    </div>
                                </div>
                                <div class="row g-2 align-items-end d-none" data-quotation-line-edit>
                                    <div class="col-lg-3">{{ form_row(line.catalogItem) }}</div>
                                    <div class="col-lg-4">{{ form_row(line.description) }}</div>
                                    <div class="col-sm-4 col-lg-2">{{ form_row(line.quantity) }}</div>
                                    <div class="col-sm-4 col-lg-2">{{ form_row(line.unitPrice) }}</div>
                                    <div class="col-8 col-lg-1">
                                        <label class="form-label">{{ 'quotation.line_subtotal'|trans }}</label>
                                        <output class="form-control-plaintext fw-bold" data-line-subtotal>0.00</output>
                                    </div>
                                    <div class="col-4 col-lg-1 text-end d-flex gap-1 justify-content-end">
                                        <button class="btn btn-icon btn-outline-success" type="button" data-confirm-quotation-line title="{{ 'confirm'|trans }}">
                                            {{ icon('success', true) }}
                                        </button>
                                        <button class="btn btn-icon btn-outline-danger" type="button" data-remove-quotation-line title="{{ 'quotation.remove_line'|trans }}">
                                            {{ icon('trash', true) }}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                        <div class="text-muted text-center py-4" data-quotation-lines-empty>
                            {{ icon('info', true) }} {{ 'quotation.lines_empty'|trans }}
                        </div>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        <div class="col-lg-4">
            <div class="quotation_summary_sticky"
                 data-quotation-summary
                 data-fx-rate-url="{{ path('quotation_fx_rate') }}"
                 data-fx-as-of-label="{{ 'quotation.fx_rate_as_of'|trans({'%currency%': '__CURRENCY__', '%rate%': '__RATE__', '%date%': '__DATE__'}) }}">
                {% embed '@theme/embeds/card.html.twig' %}
                    {% block box_title %}{{ 'quotation.summary'|trans }}{% endblock %}
                    {% block box_body %}
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">{{ 'quotation.subtotal'|trans }}</span>
                            <strong class="fs-3" data-summary-subtotal>0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">{{ 'quotation.discount_amount'|trans }}</span>
                            <strong class="fs-3" data-summary-discount>0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">{{ 'quotation.surcharge_amount'|trans }}</span>
                            <strong class="fs-3" data-summary-surcharge>0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">{{ 'quotation.tax_amount'|trans }}</span>
                            <strong class="fs-3" data-summary-tax>0.00</strong>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fs-5">{{ 'quotation.total'|trans }}</span>
                            <strong class="fs-1 text-primary" data-summary-total>0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3 text-muted d-none" data-summary-clp-row>
                            <span>
                                {{ 'quotation.clp_equivalent'|trans }}
                                <br><small data-summary-clp-date></small>
                            </span>
                            <strong data-summary-clp>—</strong>
                        </div>
                        <small class="text-muted d-block mb-3">{{ 'quotation.server_authoritative'|trans }}</small>
                        <button class="btn btn-primary w-100" type="submit">{{ 'quotation.save'|trans }}</button>
                    {% endblock %}
                {% endembed %}
            </div>
        </div>
    </div>
    {{ form_widget(form._token) }}
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const collection = document.querySelector('[data-quotation-lines]');
            const catalogButton = document.querySelector('[data-add-catalog-line]');
            const manualButton = document.querySelector('[data-add-manual-line]');
            const prototypeTemplate = document.querySelector('[data-quotation-line-prototype]');
            if (!collection || !catalogButton || !manualButton || !prototypeTemplate) return;
            const maximumLines = 10;
            let index = collection.querySelectorAll('[data-quotation-line]').length;
            const emptyState = collection.querySelector('[data-quotation-lines-empty]');
            const updateLineActions = function () {
                const atMaximum = collection.querySelectorAll('[data-quotation-line]').length >= maximumLines;
                catalogButton.disabled = atMaximum;
                manualButton.disabled = atMaximum;
            };
            const addLine = function (catalog) {
                if (collection.querySelectorAll('[data-quotation-line]').length >= maximumLines) return null;
                const prototype = prototypeTemplate.innerHTML.replace(/__name__/g, index++);
                collection.insertAdjacentHTML('beforeend', prototype);
                if (emptyState) emptyState.hidden = true;
                const line = collection.lastElementChild;
                (catalog ? line.querySelector('select[name$="[catalogItem]"]') : line.querySelector('input[name$="[description]"]'))?.focus();
                updateLineActions();
                return line;
            };
            catalogButton.addEventListener('click', function () { addLine(true); });
            manualButton.addEventListener('click', function () { addLine(false); });

            const number = function (field) { return Number.parseFloat(field?.value || '0') || 0; };
            const round2 = function (value) { return Math.round((value + Number.EPSILON) * 100) / 100; };
            const locale = document.documentElement.lang || 'es-CL';
            const currencyField = document.querySelector('[name$="[currency]"]');
            const validUntilField = document.querySelector('[name$="[validUntil]"]');
            const summaryContainer = document.querySelector('[data-quotation-summary]');
            const fxRateUrl = summaryContainer?.dataset.fxRateUrl;
            const fxAsOfLabel = summaryContainer?.dataset.fxAsOfLabel || '';
            let currentRate = null;
            let currentRateDate = null;

            const parseDateWithFormat = function (value, format) {
                if (!value || !format) return null;
                const formatParts = format.match(/[A-Za-z]+/g);
                const valueParts = value.match(/[0-9]+/g);
                if (!formatParts || !valueParts || formatParts.length !== valueParts.length) return null;
                let day = null, month = null, year = null;
                formatParts.forEach(function (token, i) {
                    const v = Number.parseInt(valueParts[i], 10);
                    if (token.charAt(0) === 'D') day = v;
                    else if (token.charAt(0) === 'M') month = v;
                    else if (token.charAt(0) === 'Y') year = v;
                });
                if (!day || !month || !year) return null;
                return String(year).padStart(4, '0') + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
            };

            const fetchRate = function () {
                const code = currencyField?.value;
                if (!fxRateUrl || !code || code === 'CLP') {
                    currentRate = null;
                    currentRateDate = null;
                    updateSummary();
                    return;
                }
                const isoDate = parseDateWithFormat(validUntilField?.value, validUntilField?.dataset.format);
                const params = new URLSearchParams({currency: code});
                if (isoDate) params.set('date', isoDate);
                fetch(fxRateUrl + '?' + params.toString(), {headers: {'Accept': 'application/json'}})
                    .then(function (response) { return response.ok ? response.json() : {available: false}; })
                    .then(function (data) {
                        currentRate = data.available ? Number.parseFloat(data.rate) : null;
                        currentRateDate = data.available ? data.rateDate : null;
                        updateSummary();
                    })
                    .catch(function () {
                        currentRate = null;
                        currentRateDate = null;
                        updateSummary();
                    });
            };
            const fractionDigitsCache = {};
            const fractionDigitsForCurrency = function (code) {
                if (fractionDigitsCache[code] !== undefined) return fractionDigitsCache[code];
                let digits = 2;
                try {
                    digits = new Intl.NumberFormat(locale, {style: 'currency', currency: code}).resolvedOptions().maximumFractionDigits;
                } catch (error) {
                    digits = 2;
                }
                fractionDigitsCache[code] = digits;
                return digits;
            };
            const formatMoney = function (value) {
                const digits = fractionDigitsForCurrency(currencyField?.value || 'CLP');
                return new Intl.NumberFormat(locale, {minimumFractionDigits: digits, maximumFractionDigits: digits}).format(value);
            };
            const updateSummary = function () {
                let subtotal = 0;
                collection.querySelectorAll('[data-quotation-line]').forEach(function (line) {
                    const lineSubtotal = number(line.querySelector('input[name$="[quantity]"]')) * number(line.querySelector('input[name$="[unitPrice]"]'));
                    subtotal += lineSubtotal;
                    line.querySelector('[data-line-subtotal]')?.replaceChildren(formatMoney(lineSubtotal));
                });
                const percentage = function (selector) { return number(document.querySelector(selector)) / 100; };
                const discount = round2(subtotal * percentage('[name$="[discount]"]'));
                const surcharge = round2(subtotal * percentage('[name$="[surcharge]"]'));
                const adjustedSubtotal = round2(subtotal - discount + surcharge);
                const tax = round2(adjustedSubtotal * percentage('[name$="[tax]"]'));
                document.querySelector('[data-summary-subtotal]')?.replaceChildren(formatMoney(subtotal));
                document.querySelector('[data-summary-discount]')?.replaceChildren(formatMoney(discount));
                document.querySelector('[data-summary-surcharge]')?.replaceChildren(formatMoney(surcharge));
                document.querySelector('[data-summary-tax]')?.replaceChildren(formatMoney(tax));
                document.querySelector('[data-summary-total]')?.replaceChildren(formatMoney(adjustedSubtotal + tax));

                const clpRow = document.querySelector('[data-summary-clp-row]');
                if (clpRow) {
                    if (currentRate !== null && currencyField?.value && currencyField.value !== 'CLP') {
                        const clpAmount = (adjustedSubtotal + tax) * currentRate;
                        clpRow.classList.remove('d-none');
                        document.querySelector('[data-summary-clp]')?.replaceChildren('≈ ' + new Intl.NumberFormat(locale, {minimumFractionDigits: 0, maximumFractionDigits: 0}).format(clpAmount) + ' CLP');
                        const currencyLabel = currencyField.value === 'CLF' ? 'UF' : currencyField.value;
                        const rateLabel = new Intl.NumberFormat(locale, {minimumFractionDigits: 2, maximumFractionDigits: 2}).format(currentRate);
                        document.querySelector('[data-summary-clp-date]')?.replaceChildren(currentRateDate
                            ? fxAsOfLabel.replace('__CURRENCY__', currencyLabel).replace('__RATE__', rateLabel).replace('__DATE__', currentRateDate)
                            : '');
                    } else {
                        clpRow.classList.add('d-none');
                    }
                }
            };
            currencyField?.addEventListener('change', function () { updateSummary(); fetchRate(); });
            validUntilField?.addEventListener('change', fetchRate);
            collection.addEventListener('change', function (event) {
                const select = event.target.closest('select[name$="[catalogItem]"]');
                if (select) {
                    const option = select.selectedOptions[0];
                    const line = select.closest('[data-quotation-line]');
                    if (option?.dataset.description) line.querySelector('input[name$="[description]"]').value = option.dataset.description;
                    if (option?.dataset.unitPrice) line.querySelector('input[name$="[unitPrice]"]').value = option.dataset.unitPrice;
                }
                updateSummary();
            });
            collection.addEventListener('input', updateSummary);
            document.querySelectorAll('[name$="[discount]"], [name$="[surcharge]"], [name$="[tax]"]').forEach(function (field) { field.addEventListener('input', updateSummary); });
            collection.addEventListener('click', function (event) {
                const editButton = event.target.closest('[data-edit-quotation-line]');
                if (editButton) {
                    const line = editButton.closest('[data-quotation-line]');
                    line?.querySelector('[data-quotation-line-view]')?.classList.add('d-none');
                    line?.querySelector('[data-quotation-line-edit]')?.classList.remove('d-none');
                }
                const confirmButton = event.target.closest('[data-confirm-quotation-line]');
                if (confirmButton) {
                    const line = confirmButton.closest('[data-quotation-line]');
                    if (line) {
                        const quantity = number(line.querySelector('input[name$="[quantity]"]'));
                        const unitPrice = number(line.querySelector('input[name$="[unitPrice]"]'));
                        const description = line.querySelector('input[name$="[description]"]')?.value ?? '';
                        line.querySelector('[data-view-description]')?.replaceChildren(description);
                        line.querySelector('[data-view-quantity]')?.replaceChildren(String(quantity));
                        line.querySelector('[data-view-unit-price]')?.replaceChildren(formatMoney(unitPrice));
                        line.querySelector('[data-view-line-subtotal]')?.replaceChildren(formatMoney(quantity * unitPrice));
                        line.querySelector('[data-quotation-line-edit]')?.classList.add('d-none');
                        line.querySelector('[data-quotation-line-view]')?.classList.remove('d-none');
                    }
                }
                const button = event.target.closest('[data-remove-quotation-line]');
                if (button) {
                    button.closest('[data-quotation-line]')?.remove();
                    if (emptyState) emptyState.hidden = collection.querySelectorAll('[data-quotation-line]').length === 0;
                    updateLineActions();
                }
                updateSummary();
            });
            if (emptyState) emptyState.hidden = collection.querySelectorAll('[data-quotation-line]').length > 0;
            updateLineActions();
            updateSummary();
            fetchRate();
        });
    </script>
{% endblock %}
