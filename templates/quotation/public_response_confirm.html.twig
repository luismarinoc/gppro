<!doctype html>
<html lang="{{ app.request.locale }}">
<head><meta charset="utf-8"><title>{{ 'quotation.response.title'|trans }}</title></head>
<body>
    <h1>{{ 'quotation.view_title'|trans }} #{{ quotation.id }}</h1>
    <p>{{ 'quotation.response.prompt'|trans }}</p>
    <form method="post">
        <input type="hidden" name="token" value="{{ token }}">
        <button type="submit" name="response" value="accepted">{{ 'quotation.accept_action'|trans }}</button>
        <button type="submit" name="response" value="rejected">{{ 'quotation.reject_action'|trans }}</button>
    </form>
</body>
</html>
