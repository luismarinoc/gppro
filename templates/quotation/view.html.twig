{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'quotation.view_title'|trans }} #{{ quotation.id }}</h3>
            <div class="card-actions">
                <a class="btn btn-outline-secondary" href="{{ path('quotation_pdf', {id: quotation.id}) }}" target="_blank" rel="noopener">{{ icon('print', true) }} {{ 'quotation.view_pdf'|trans }}</a>
                {% if is_granted('edit_quotation', quotation) %}<a class="btn btn-primary" href="{{ path('quotation_edit', {id: quotation.id}) }}">{{ 'edit'|trans }}</a>{% endif %}
                {% if quotation.status == 'draft' and is_granted('send_quotation', quotation) %}
                    <form method="post" action="{{ path('quotation_send', {id: quotation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quotation_send_' ~ quotation.id) }}"><button class="btn btn-success" type="submit">{{ 'quotation.send_action'|trans }}</button></form>
                {% endif %}
                {% if quotation.status == 'accepted' and is_granted('convert_quotation', quotation) %}
                    <form method="post" action="{{ path('quotation_convert', {id: quotation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('quotation_convert_' ~ quotation.id) }}"><button class="btn btn-primary" type="submit">{{ 'quotation.convert_action'|trans }}</button></form>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">{{ 'customer'|trans }}</dt><dd class="col-sm-9">{{ quotation.customer.name }}</dd>
                <dt class="col-sm-3">{{ 'project'|trans }}</dt><dd class="col-sm-9">{{ quotation.project ? quotation.project.name : '-' }}</dd>
                <dt class="col-sm-3">{{ 'status'|trans }}</dt><dd class="col-sm-9">{{ ('quotation.status.' ~ quotation.status)|trans }}</dd>
                <dt class="col-sm-3">{{ 'quotation.valid_until'|trans }}</dt><dd class="col-sm-9">{{ quotation.validUntil ? quotation.validUntil|date('Y-m-d') : '-' }}</dd>
            </dl>
            <table class="table table-vcenter">
                <thead><tr><th>{{ 'quotation.description'|trans }}</th><th class="text-end">{{ 'quotation.quantity'|trans }}</th><th class="text-end">{{ 'quotation.unit_price'|trans }}</th><th class="text-end">{{ 'quotation.line_subtotal'|trans }}</th></tr></thead>
                <tbody>
                {% for item in summary.items %}
                    <tr>
                        <td>{{ item.line.description }}</td>
                        <td class="text-end">{{ item.amount }}</td>
                        <td class="text-end">{{ item.fixedRate|money(currency) }}</td>
                        <td class="text-end">{{ item.rate|money(currency) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <table class="table table-vcenter w-auto ms-auto">
                <tbody>
                    <tr><td>{{ 'quotation.subtotal'|trans }}</td><td class="text-end">{{ summary.subtotal|money(currency) }}</td></tr>
                    {% if quotation.discount is not null %}<tr><td>{{ 'quotation.discount_amount'|trans }} ({{ quotation.discount }}%)</td><td class="text-end">-{{ summary.discountAmount|money(currency) }}</td></tr>{% endif %}
                    {% if quotation.surcharge is not null %}<tr><td>{{ 'quotation.surcharge_amount'|trans }} ({{ quotation.surcharge }}%)</td><td class="text-end">{{ summary.surchargeAmount|money(currency) }}</td></tr>{% endif %}
                    <tr><td>{{ 'quotation.adjusted_subtotal'|trans }}</td><td class="text-end">{{ summary.adjustedSubtotal|money(currency) }}</td></tr>
                    {% if summary.taxAmount is not null %}<tr><td>{{ 'quotation.tax_amount'|trans }} ({{ quotation.tax }}%)</td><td class="text-end">{{ summary.taxAmount|money(currency) }}</td></tr>{% endif %}
                    <tr class="fw-bold fs-5"><td>{{ 'quotation.total'|trans }}</td><td class="text-end">{{ summary.total|money(currency) }}</td></tr>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
