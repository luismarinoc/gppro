{% extends 'base.html.twig' %}

{% block main %}
    <div class="gp-workflow gp-workflow--invoice">
        <div class="card gp-workflow--invoice__approval-level-form gp-workflow__surface">
            <div class="card-header gp-workflow__header">
                <h3 class="card-title">{{ (level.id ? 'invoice_payment_approval_level.edit_title' : 'invoice_payment_approval_level.create_title')|trans }}</h3>
            </div>
            <div class="card-body gp-workflow__section">
                {{ form_start(form, {attr: {class: 'gp-workflow__form'}}) }}
                {{ form_widget(form) }}
                <div class="gp-workflow__actions">
                    <button class="btn btn-primary" type="submit">{{ 'action.save'|trans }}</button>
                    <a class="btn btn-link" href="{{ path('admin_invoice_payment_approval_level_list') }}">{{ 'cancel'|trans }}</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
