<!doctype html>
<html lang="{{ app.request.locale }}">
<body>
    <h1>{{ 'quotation.view_title'|trans }} #{{ quotation.id }}</h1>
    <p>{{ 'quotation.email.review_prompt'|trans({'%customer%': quotation.customer.name}) }}</p>
    <p><a href="{{ accept_url }}">{{ 'quotation.accept_action'|trans }}</a></p>
    <p><a href="{{ reject_url }}">{{ 'quotation.reject_action'|trans }}</a></p>
    <p>{{ 'quotation.email.confirmation_hint'|trans }}</p>
</body>
</html>
