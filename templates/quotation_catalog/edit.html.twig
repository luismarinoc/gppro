{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ item.id ? 'quotation_catalog.edit_title'|trans : 'quotation_catalog.add'|trans }}</h3></div>
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary" type="submit">{{ 'action.save'|trans }}</button>
            <a class="btn btn-link" href="{{ path('admin_quotation_catalog') }}">{{ 'cancel'|trans }}</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
