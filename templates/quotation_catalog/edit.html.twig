{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ item.id ? 'Edit catalog item' : 'Add catalog item' }}</h3></div>
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-link" href="{{ path('admin_quotation_catalog') }}">Cancel</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
