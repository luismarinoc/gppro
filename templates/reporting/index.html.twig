{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block page_actions %}
    {% set event = actions(app.user, 'reporting', 'report') %}
    {{ widgets.page_actions(event.actions) }}
{% endblock %}

{% block main %}
    <div class="row-cards gp-reporting">
        <ul class="gp-reporting-list" role="list">
            {% for report in reports %}
                <li class="gp-reporting-item">
                    <a class="card-link gp-reporting-link" href="{{ path(report.route) }}">
                        <span class="gp-reporting-icon" aria-hidden="true"><i class="icon {{ report.reportIcon|icon(false, report.reportIcon) }}" style="color: {{ null|colorize(report.reportIcon) }}"></i></span>
                        <span class="gp-reporting-label">{{ report.label|trans({}, report.translationDomain) }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
