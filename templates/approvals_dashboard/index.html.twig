{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block main %}
    <div class="gp-workflow gp-workflow--approvals">
        {% if expenses is empty and timesheets is empty and invoices is empty %}
            <div class="card gp-workflow__surface">
                <div class="card-body gp-workflow--approvals__state gp-workflow-state gp-workflow-state--empty">{{ 'approvals_dashboard.none_pending'|trans }}</div>
            </div>
        {% else %}
            <section class="card gp-workflow__section gp-workflow--approvals__section gp-workflow__surface" data-gp-approval-domain="expense">
                <div class="card-header"><h3 class="card-title">{{ 'approvals_dashboard.section_expense'|trans }}</h3></div>
                {% if expenses is empty %}
                    <div class="card-body gp-workflow-state gp-workflow-state--empty">{{ 'expense.none_pending'|trans }}</div>
                {% else %}
                    <div class="gp-workflow__table-scroll">
                        <table class="table table-vcenter card-table gp-workflow__table">
                            <thead><tr><th>{{ 'description'|trans }}</th><th>{{ 'expense.amount'|trans }}</th><th>{{ 'actions'|trans }}</th></tr></thead>
                            <tbody>
                            {% for expense in expenses %}
                                <tr>
                                    <td>{{ expense.description }}</td>
                                    <td>{{ expense.amount|money(expense.currency) }}</td>
                                    <td class="text-end"><a href="{{ path('expense_view', {id: expense.id}) }}" aria-label="{{ 'expense.review'|trans }}: {{ expense.description }}">{{ 'expense.review'|trans }}</a></td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>

            <section class="card gp-workflow__section gp-workflow--approvals__section gp-workflow__surface" data-gp-approval-domain="invoice">
                <div class="card-header"><h3 class="card-title">{{ 'approvals_dashboard.section_invoice'|trans }}</h3></div>
                {% if invoices is empty %}
                    <div class="card-body gp-workflow-state gp-workflow-state--empty">{{ 'approvals_dashboard.none_pending_invoice'|trans }}</div>
                {% else %}
                    <div class="gp-workflow__table-scroll">
                        <table class="table table-vcenter card-table gp-workflow__table">
                            <thead><tr><th>{{ 'invoice.number'|trans }}</th><th>{{ 'invoice.total'|trans }}</th><th>{{ 'actions'|trans }}</th></tr></thead>
                            <tbody>
                            {% for invoice in invoices %}
                                <tr>
                                    <td>{{ invoice.invoiceNumber }}</td>
                                    <td>{{ invoice.total }}</td>
                                    <td class="text-end"><a href="{{ path('admin_invoice_edit', {id: invoice.id}) }}" aria-label="{{ 'approvals_dashboard.review'|trans }}: {{ invoice.invoiceNumber }}">{{ 'approvals_dashboard.review'|trans }}</a></td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>

            <section class="card gp-workflow__section gp-workflow--approvals__section gp-workflow__surface" data-gp-approval-domain="timesheet">
                <div class="card-header"><h3 class="card-title">{{ 'approvals_dashboard.section_timesheet'|trans }}</h3></div>
                {% if timesheets is empty %}
                    <div class="card-body gp-workflow-state gp-workflow-state--empty">{{ 'approvals_dashboard.none_pending_timesheet'|trans }}</div>
                {% else %}
                    <div class="gp-workflow__table-scroll">
                        <table class="table table-vcenter card-table gp-workflow__table">
                            <thead>
                                <tr>
                                    <th>{{ 'user'|trans }}</th>
                                    <th>{{ 'customer'|trans }}</th>
                                    <th>{{ 'project'|trans }}</th>
                                    <th>{{ 'activity'|trans }}</th>
                                    <th>{{ 'begin'|trans }}</th>
                                    <th>{{ 'duration'|trans }}</th>
                                    <th>{{ 'actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for timesheet in timesheets %}
                                <tr>
                                    <td>{{ widgets.user_avatar(timesheet.user) }}</td>
                                    <td>{{ widgets.label_customer(timesheet.project.customer) }}</td>
                                    <td>{{ widgets.label_project(timesheet.project) }}</td>
                                    <td>{{ widgets.label_activity(timesheet.activity) }}</td>
                                    <td>{{ timesheet.begin|date('Y-m-d H:i') }}</td>
                                    <td>{{ widgets.duration(timesheet) }}</td>
                                    <td class="text-end">
                                        <div class="gp-workflow__actions gp-workflow--approvals__actions">
{% if is_granted('approve_timesheet', timesheet) %}
<form class="d-inline" method="post" action="{{ path('admin_timesheet_approve', {id: timesheet.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('admin_timesheet_approve_' ~ timesheet.id) }}">
<button class="btn btn-sm btn-link" type="submit">{{ 'approve'|trans }}</button>
</form>
{% endif %}
{% if is_granted('reject_timesheet', timesheet) %}
<form class="d-inline" method="post" action="{{ path('admin_timesheet_reject', {id: timesheet.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('admin_timesheet_reject_' ~ timesheet.id) }}">
<button class="btn btn-sm btn-link text-danger" type="submit">{{ 'reject'|trans }}</button>
</form>
{% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}
