{% extends 'datatable.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}
{% import "macros/datatables.html.twig" as tables %}
{% import "invoice/actions.html.twig" as actions %}

{% block datatable_row %}
    <tr class="modal-ajax-form open-edit{% if entry.canceled %} text-body-secondary{% endif %}" data-href="{{ path('admin_invoice_edit', {'id': entry.id}) }}">
        <td class="{{ tables.class(dataTable, 'avatar') }}">{{ widgets.user_avatar(entry.user) }}</td>
        <td class="{{ tables.class(dataTable, 'date') }}">{{ entry.createdAt|date_short }}</td>
        <td class="{{ tables.class(dataTable, 'user') }}">{{ widgets.label_user(entry.user) }}</td>
        <td class="{{ tables.class(dataTable, 'customer') }}">{{ widgets.label_customer(entry.customer) }}</td>
        <td class="{{ tables.class(dataTable, 'type') }}">{{ _self.invoice_type(entry, milestone_invoice_ids) }}</td>
        <td class="{{ tables.class(dataTable, 'project') }}">{{ invoice_projects[entry.id]|default([])|join(', ') }}</td>
        <td class="{{ tables.class(dataTable, 'comment') }}">
            {% if entry.comment is not empty %}
                {{ entry.comment }}
            {% elseif entry.id in milestone_invoice_ids %}
                {% for milestone in invoice_milestones[entry.id]|default([]) %}
                    {{ milestone.name }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            {% elseif invoice_durations[entry.id]|default(0) > 0 %}
                {{ invoice_durations[entry.id]|duration }}
            {% endif %}
        </td>
        {% for field in metaColumns %}
            <td class="{{ tables.class(dataTable, 'mf_' ~ field.name) }}">
                {{ tables.datatable_meta_column(entry, field) }}
            </td>
        {% endfor %}
        <td class="{{ tables.class(dataTable, 'invoice_number') }}">{{ widgets.label(entry.invoiceNumber, 'default') }}</td>
        <td class="{{ tables.class(dataTable, 'due_date') }}">{{ _self.invoice_due_date(entry) }}</td>
        <td class="{{ tables.class(dataTable, 'payment_date') }}">
            {% if entry.paymentDate and entry.paid %}
                {{ widgets.label(entry.paymentDate|date_short, 'primary') }}
            {% endif %}
        </td>
        <td class="{{ tables.class(dataTable, 'status') }}">{{ _self.invoice_status(entry) }}</td>
        <td class="{{ tables.class(dataTable, 'subtotal') }}">{{ entry.subtotal|money(entry.currency) }}</td>
        <td class="{{ tables.class(dataTable, 'tax') }}">{{ entry.tax|money(entry.currency) }}</td>
        <td class="{{ tables.class(dataTable, 'total_rate') }}">{{ entry.total|money(entry.currency) }}</td>
        <td class="{{ tables.class(dataTable, 'actions') }}">{{ actions.invoice(entry, 'index') }}</td>
    </tr>
{% endblock %}

{% block main %}
    {{ parent() }}

    {% if invoice_history_summary is defined and invoice_history_summary|length > 0 %}
        {% embed '@theme/embeds/card.html.twig' with {fullsize: true} %}
            {% block box_title %}{{ 'invoice.history_totals'|trans }}{% endblock %}
            {% block box_attributes %}id="invoice_history_summary_box"{% endblock %}
            {% block box_body_class %}p-0{% endblock %}
            {% block box_body %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>{{ 'customer'|trans }}</th>
                                <th>{{ 'project'|trans }}</th>
                                <th>{{ 'invoice_type'|trans }}</th>
                                <th class="text-end">{{ 'invoice.number'|trans }}</th>
                                <th class="text-end">{{ 'invoice.total'|trans }}</th>
                                <th class="text-end">{{ 'duration'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for row in invoice_history_summary %}
                            <tr class="{% if row.isMilestone() %}milestone_total_row{% else %}timesheet_total_invoiced_row{% endif %}">
                                <td>{{ row.customerName }}</td>
                                <td>{{ row.projectName }}</td>
                                <td>
                                    {% if row.isMilestone() %}
                                        {{ 'invoice_type.milestone'|trans }}
                                    {% else %}
                                        {{ 'invoice_type.timesheet'|trans }}
                                    {% endif %}
                                </td>
                                <td class="text-end">{{ row.invoiceCount }}</td>
                                <td class="text-end text-nowrap">
                                    {% if row.amount is not null %}
                                        {{ row.amount|money(row.currency) }}
                                    {% else %}
                                        &ndash;
                                    {% endif %}
                                    {% if row.isPartial %}
                                        <span class="badge bg-warning text-warning-fg milestone_total_partial" data-toggle="tooltip" data-placement="top" title="{{ 'milestone.total_partial'|trans({'%count%': row.excludedCount}) }}">!</span>
                                    {% endif %}
                                </td>
                                <td class="text-end text-nowrap">
                                    {% if row.durationSeconds is not null %}
                                        {{ row.durationSeconds|duration }}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}

{% macro invoice_status(invoice) %}
    {% from "macros/widgets.html.twig" import label %}
    {% set overdue = invoice.overdue %}
    {% if invoice.new and overdue %}
        {{ label('status.new'|trans, 'danger') }}
    {% elseif invoice.new %}
        {{ label('status.new'|trans, 'primary') }}
    {% elseif invoice.pending and overdue %}
        {{ label('status.pending'|trans, 'danger') }}
    {% elseif invoice.pending %}
        {{ label('status.pending'|trans, 'warning') }}
    {% elseif invoice.paid %}
        {{ label('status.paid'|trans, 'success') }}
    {% elseif invoice.canceled %}
        {{ label('status.canceled'|trans, 'gray') }}
    {% endif %}
{% endmacro %}

{% macro invoice_type(invoice, milestone_invoice_ids) %}
    {% from "macros/widgets.html.twig" import label %}
    {% if invoice.id in milestone_invoice_ids %}
        {{ label('invoice_type.milestone'|trans, 'gray') }}
    {% else %}
        {{ label('invoice_type.timesheet'|trans, 'gray') }}
    {% endif %}
{% endmacro %}

{% macro invoice_due_date(invoice) %}
    {% from "macros/widgets.html.twig" import label %}
    {% if invoice.canceled %}
        {{ label('status.canceled'|trans, 'gray') }}
    {% elseif invoice.overdue and not invoice.paid %}
        {{ label(invoice.dueDate|date_short, 'danger') }}
    {% else %}
        {{ label(invoice.dueDate|date_short, 'primary') }}
    {% endif %}
{% endmacro %}
