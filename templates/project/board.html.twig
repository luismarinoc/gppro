{% extends 'base.html.twig' %}

{% block main %}
    {% import "macros/widgets.html.twig" as widgets %}

    {% embed '@theme/embeds/card.html.twig' with {fullsize: true} %}
        {% import "macros/widgets.html.twig" as widgets %}
        {% block box_attributes %}id="activity_board_box" data-update-url="{{ path('project_board_card_update', {id: project.id, activity: '000'}) }}" data-edit-url="{{ path('admin_activity_edit', {id: '000'}) }}"{% endblock %}
        {% block box_title %}
            <span class="d-flex align-items-center flex-wrap">
                {{ widgets.label_dot(project.name, project.color) }}
                {% if project.comment is not empty %}
                    <span class="text-body-secondary ms-2">{{ project.comment|comment1line(false) }}</span>
                {% endif %}
            </span>
        {% endblock %}
        {% block box_body %}
            <div class="activity_board_toolbar d-flex flex-wrap align-items-end gap-2">
                <div class="activity_board_search flex-grow-1">
                    <label class="form-label visually-hidden" for="activity_board_search">{{ 'activity_board.search'|trans }}</label>
                    <div class="input-icon">
                        <span class="input-icon-addon">{{ icon('search') }}</span>
                        <input type="search" class="form-control" id="activity_board_search" placeholder="{{ 'activity_board.search_placeholder'|trans }}" autocomplete="off">
                    </div>
                </div>
                <div class="activity_board_filter">
                    <label class="form-label" for="activity_board_status_filter">{{ 'activity_board.filter_status'|trans }}</label>
                    <select class="form-select" id="activity_board_status_filter">
                        <option value="">{{ 'activity_board.all_statuses'|trans }}</option>
                        {% for status in ['todo', 'in_progress', 'in_review', 'done'] %}
                            <option value="{{ status }}">{{ ('activity_board.status.' ~ status)|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="activity_board_filter">
                    <label class="form-label" for="activity_board_priority_filter">{{ 'activity_board.filter_priority'|trans }}</label>
                    <select class="form-select" id="activity_board_priority_filter">
                        <option value="">{{ 'activity_board.all_priorities'|trans }}</option>
                        {% for priority in ['urgent', 'high', 'medium', 'low'] %}
                            <option value="{{ priority }}">{{ ('activity_board.priority.' ~ priority)|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="activity_board_filter">
                    <label class="form-label" for="activity_board_assignee_filter">{{ 'activity_board.filter_assignee'|trans }}</label>
                    <select class="form-select" id="activity_board_assignee_filter" data-unassigned-label="{{ 'activity_board.unassigned'|trans }}">
                        <option value="">{{ 'activity_board.all_assignees'|trans }}</option>
                    </select>
                </div>
                {% if project.visible and project.customer.visible and is_granted('create_activity') %}
                    {{ widgets.action_button('create', {'url': path('admin_activity_create_with_project', {'project': project.id}), 'class': 'btn btn-primary modal-ajax-form open-edit', 'title': 'activity_board.new_activity'|trans}) }}
                {% endif %}
            </div>
            <div class="activity_board d-flex">
                {% for status, column in columns %}
                    <div class="activity_board_column flex-fill" data-status="{{ status }}">
                        <div class="activity_board_column_header d-flex align-items-center justify-content-between">
                            <span class="activity_board_column_title">{{ ('activity_board.status.' ~ status)|trans }}</span>
                            <span class="activity_board_column_count">{{ widgets.badge_counted(column.cards|length) }}</span>
                        </div>
                        <div class="activity_board_column_body">
                            {% if column.cards|length == 0 %}
                                <div class="comment activity_board_column_empty">{{ 'activity_board.empty'|trans }}</div>
                            {% else %}
                                {% for card in column.cards %}
                                    {% include 'project/_board_card.html.twig' with {'card': card} %}
                                {% endfor %}
                            {% endif %}
                            <div class="comment activity_board_column_no_matches d-none">{{ 'activity_board.no_matches'|trans }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('board') }}
{% endblock %}

{% block head %}
    {{ parent() }}
    {{ encore_entry_script_tags('board') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        document.addEventListener('gppro.initialized', function(event) {
            GpproActivityBoard.create('#activity_board_box', event.detail.gppro);
        });
    </script>
{% endblock %}
