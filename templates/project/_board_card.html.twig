{% import "macros/widgets.html.twig" as widgets %}
{% set priorityColors = {'urgent': 'red', 'high': 'orange', 'medium': 'azure', 'low': 'secondary'} %}
<div class="activity_board_card" data-activity-id="{{ card.activity.id }}">
    <div class="activity_board_card_name">{{ card.activity.name }}</div>
    <div class="activity_board_card_meta d-flex align-items-center justify-content-between">
        <span class="activity_board_card_priority">
            {%- if card.priority is not null -%}
                {{ widgets.badge_type(('activity_board.priority.' ~ card.priority.value)|trans, priorityColors[card.priority.value]) }}
            {%- endif -%}
        </span>
        <span class="activity_board_card_due_date">
            {%- if card.dueDate is not null -%}
                {{ card.dueDate|date_short }}
            {%- endif -%}
        </span>
    </div>
    {% if card.technicalUser is null and card.functionalUser is null %}
        <div class="activity_board_card_assignee">
            <span class="text-muted">{{ 'activity_board.unassigned'|trans }}</span>
        </div>
    {% endif %}
    {% if card.technicalUser is not null or card.functionalUser is not null %}
        <div class="activity_board_card_roles">
            {% if card.technicalUser is not null %}
                <div class="activity_board_card_role">
                    <span class="activity_board_card_role_label">{{ 'activity_board.technical_user'|trans }}</span>
                    {{ widgets.user_avatar(card.technicalUser, card.technicalUser.displayName, 'avatar-sm') }} {{ card.technicalUser.displayName }}
                </div>
            {% endif %}
            {% if card.functionalUser is not null %}
                <div class="activity_board_card_role">
                    <span class="activity_board_card_role_label">{{ 'activity_board.functional_user'|trans }}</span>
                    {{ widgets.user_avatar(card.functionalUser, card.functionalUser.displayName, 'avatar-sm') }} {{ card.functionalUser.displayName }}
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
