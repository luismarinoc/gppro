{% embed '@theme/embeds/card.html.twig' with {'id': id, 'entity': entity, 'create_url': create_url} %}
    {% import "macros/widgets.html.twig" as widgets %}
    {% block box_attributes %}id="{{ id }}"{% endblock %}
    {% block box_title %}
        {{ 'milestone.title'|trans }}
    {% endblock %}
    {% block box_tools %}
        {{ widgets.card_tool_button('create', {'class': 'modal-ajax-form open-edit', 'title': 'create', 'url': create_url}) }}
    {% endblock %}
    {% block box_body_class %}{% if milestones is not empty %}p-0{% endif %}{% endblock %}
    {% block box_body %}
        {% if milestones is empty %}
            <div class="comment">{{ 'milestone.empty'|trans }}</div>
        {% else %}
            <table class="table dataTable">
                <thead>
                <tr>
                    <th>{{ 'name'|trans }}</th>
                    <th class="d-none d-sm-table-cell">{{ 'due_date'|trans }}</th>
                    <th class="actions"></th>
                </tr>
                </thead>
                <tbody>
                {% for milestone in milestones %}
                    <tr class="modal-ajax-form open-edit" data-href="{{ path('admin_milestone_edit', {'id': entity.id, 'milestone': milestone.id}) }}">
                        <td>{{ milestone.name }}</td>
                        <td class="d-none d-sm-table-cell">
                            {% if milestone.dueDate is not null %}
                                {{ milestone.dueDate|date_short }}
                            {% else %}
                                &ndash;
                            {% endif %}
                        </td>
                        <td class="actions">
                            <div class="btn-group">
                                <a href="{{ path('admin_milestone_edit', {'id': entity.id, 'milestone': milestone.id}) }}" class="modal-ajax-form btn btn-icon">{{ icon('edit', true) }}</a>
                                <a href="{{ path('admin_milestone_delete', {'id': entity.id, 'milestone': milestone.id}) }}" class="modal-ajax-form btn btn-icon">{{ icon('delete', true) }}</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endblock %}
{% endembed %}
