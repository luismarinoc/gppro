<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'expense.pdf_title'|trans }} #{{ expense.id }}</title>
    <style>
        body { font-family: sans-serif; font-size: 11pt; color: #222; }
        .quotation-logo { max-height: 46px; max-width: 260px; margin-bottom: 6px; display: block; }
        .doc-header { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
        .doc-header td { padding: 0; border: 0; vertical-align: top; }
        .doc-header .doc-issuer-cell { width: 60%; }
        .doc-issuer-name { margin: 0; font-size: 13pt; font-weight: bold; text-transform: uppercase; color: #183870; }
        .doc-meta { width: 40%; text-align: right; }
        .doc-type { margin: 0 0 4px; font-size: 20pt; font-weight: bold; text-transform: uppercase; color: #183870; }
        .doc-meta p { margin: 2px 0; color: #555; font-size: 10pt; }
        .doc-meta strong { color: #222; }
        .doc-accent-bar { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
        .doc-accent-bar td { padding: 0; border: 0; height: 3px; line-height: 3px; font-size: 1px; }
        .doc-accent-bar td:nth-child(1) { background: #183870; }
        .doc-accent-bar td:nth-child(2) { background: #e00830; }
        .doc-accent-bar td:nth-child(3) { background: #009038; }
        .doc-details { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .doc-details td { padding: 5px 4px; border-bottom: 1px solid #eee; }
        .doc-details td:first-child { width: 40%; color: #777; }
        .doc-details td:last-child { text-align: right; font-weight: bold; }
        .doc-amount { margin: 4px 0 20px; padding: 10pt 12pt; background: #eef2fa; }
        .doc-amount .label { font-size: 9pt; text-transform: uppercase; letter-spacing: .04em; color: #777; margin: 0 0 2px; }
        .doc-amount .value { font-size: 20pt; font-weight: bold; color: #183870; margin: 0; }
        table.section { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        table.section th, table.section td { padding: 7px 4px; border-bottom: 1px solid #ddd; text-align: left; }
        table.section th { background: #183870; color: #fff; border-bottom: none; }
        table.section .number { text-align: right; }
        h4.section-title { margin: 0 0 6px; font-size: 9.5pt; text-transform: uppercase; letter-spacing: .04em; color: #777; }
    </style>
</head>
<body>
    {% set issuerName = config('theme.branding.company') is not empty ? config('theme.branding.company') : 'Gpartner Consulting' %}
    {% set logo = config('theme.branding.logo') is not empty ? config('theme.branding.logo') : defaultLogo %}

    <table class="doc-header" cellpadding="0" cellspacing="0">
        <tr>
            <td class="doc-issuer-cell">
                {% if logo is not empty %}<img class="quotation-logo" src="{{ logo }}" alt="{{ issuerName }}">{% endif %}
                <p class="doc-issuer-name">{{ issuerName }}</p>
            </td>
            <td class="doc-meta">
                <p class="doc-type">{{ 'expense.pdf_title'|trans }}</p>
                <p><strong>{{ 'quotation.number'|trans }}:</strong> {{ expense.id }}</p>
                <p><strong>{{ 'quotation.issue_date'|trans }}:</strong> {{ "now"|date('d/m/Y') }}</p>
                <p><strong>{{ 'status'|trans }}:</strong> {{ ('expense.status.' ~ expense.status)|trans }}</p>
            </td>
        </tr>
    </table>
    <table class="doc-accent-bar" cellpadding="0" cellspacing="0"><tr><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr></table>

    <div class="doc-amount">
        <p class="label">{{ 'expense.amount'|trans }}</p>
        <p class="value">{{ expense.amount|money(expense.currency) }}</p>
    </div>

    <table class="doc-details" cellpadding="0" cellspacing="0">
        <tr><td>{{ 'expense.description'|trans }}</td><td>{{ expense.description }}</td></tr>
        <tr><td>{{ 'expense.date'|trans }}</td><td>{{ expense.expenseDate ? expense.expenseDate|date('d/m/Y') : '-' }}</td></tr>
        <tr><td>{{ 'expense.category'|trans }}</td><td>{{ expense.category ? ('expense.category.' ~ expense.category)|trans : 'expense.category_none'|trans }}</td></tr>
        {% if expense.createdBy %}<tr><td>{{ 'expense.created_by'|trans }}</td><td>{{ expense.createdBy.displayName }}</td></tr>{% endif %}
    </table>

    {% if expense.allocations|length > 0 %}
        <h4 class="section-title">{{ 'expense.allocations'|trans }}</h4>
        <table class="section">
            <thead>
                <tr>
                    <th>{{ 'expense.allocation_project'|trans }}</th>
                    <th class="number">{{ 'expense.allocation_percentage'|trans }}</th>
                    <th class="number">{{ 'expense.allocation_amount'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for allocation in expense.allocations %}
                <tr>
                    <td>{{ allocation.project ? allocation.project.name : '-' }}</td>
                    <td class="number">{{ allocation.percentage + 0 }}%</td>
                    <td class="number">{{ allocation.amountClp|money('CLP') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if expense.approvals|length > 0 %}
        <h4 class="section-title">{{ 'expense.approval_progress'|trans }}</h4>
        <table class="section">
            <thead>
                <tr>
                    <th>{{ 'expense.approval_level'|trans }}</th>
                    <th>{{ 'expense.decision'|trans }}</th>
                    <th>{{ 'expense.approval_by'|trans }}</th>
                    <th>{{ 'expense.approval_date'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for approval in expense.approvals %}
                <tr>
                    <td>{{ approval.level }}</td>
                    <td>{{ approval.decision }}</td>
                    <td>{{ approval.approvedBy ? approval.approvedBy.displayName : '-' }}</td>
                    <td>{{ approval.approvedAt ? approval.approvedAt|date('d/m/Y') : '-' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</body>
</html>
