{% extends 'base.html.twig' %}

{% block main %}
    <div class="card gp-workflow gp-workflow--expense gp-workflow__surface">
        <div class="card-header gp-workflow__header"><h3 class="card-title">{{ (expense.id ? 'expense.edit_title' : 'expense.create_title')|trans }}</h3></div>
            <div class="card-body gp-workflow--expense__editor">
                {{ form_start(form, {attr: {class: 'gp-workflow__form'}}) }}
                {{ form_errors(form) }}
                <div class="gp-workflow--expense__form-grid">
                    {{ form_row(form.description) }}
                    {{ form_row(form.amount) }}
                    {{ form_row(form.currency) }}
                    {{ form_row(form.expenseDate) }}
                </div>
                <div class="form-text mb-3 gp-workflow__status gp-workflow--expense__currency-status"
                     role="status"
                     aria-live="polite"
                     aria-atomic="true"
                     data-state="idle"
                     data-expense-currency-preview
                     data-currency-preview-url="{{ path('expense_currency_preview') }}"
                     data-trans-loading="{{ 'expense.currency_preview.loading'|trans }}"
                     data-trans-converted="{{ 'expense.currency_preview.converted'|trans({'%amount%': '__AMOUNT__', '%date%': '__DATE__'}) }}"
                     data-trans-unavailable="{{ 'expense.currency_preview.unavailable'|trans }}"></div>
                {{ form_row(form.category) }}
                {{ form_row(form.recurrence) }}

                <div class="gp-workflow--expense__allocations">
                <label class="form-label">{{ 'expense.allocations'|trans }}</label>
            {{ form_errors(form.allocations) }}
            <template data-expense-allocation-prototype>
                <div class="row g-2 align-items-end mb-2" data-expense-allocation>
                    <div class="col-md-6">{{ form_row(form.allocations.vars.prototype.project) }}</div>
                    <div class="col-md-4">{{ form_row(form.allocations.vars.prototype.percentage) }}</div>
                    <div class="col-md-2 text-end">
                        <button class="btn btn-outline-danger btn-sm" type="button" data-remove-expense-allocation>{{ 'expense.allocation_remove'|trans }}</button>
                    </div>
                </div>
            </template>
            <div data-expense-allocations>
                {% for allocation in form.allocations %}
                    <div class="row g-2 align-items-end mb-2" data-expense-allocation>
                        <div class="col-md-6">{{ form_row(allocation.project) }}</div>
                        <div class="col-md-4">{{ form_row(allocation.percentage) }}</div>
                        <div class="col-md-2 text-end">
                            <button class="btn btn-outline-danger btn-sm" type="button" data-remove-expense-allocation>{{ 'expense.allocation_remove'|trans }}</button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <button class="btn btn-outline-secondary btn-sm mb-3" type="button" data-add-expense-allocation>{{ 'expense.allocation_add'|trans }}</button>
            </div>
            <div class="gp-workflow__actions">
                <button class="btn btn-primary" type="submit">{{ 'action.save'|trans }}</button>
                {% if expense.id %}
                    <a class="btn btn-link" href="{{ path('expense_view', {id: expense.id}) }}">{{ 'cancel'|trans }}</a>
                {% else %}
                    <a class="btn btn-link" href="{{ path('expense_list') }}">{{ 'cancel'|trans }}</a>
                {% endif %}
            </div>
            {{ form_widget(form._token) }}
            {{ form_end(form, {render_rest: false}) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const collection = document.querySelector('[data-expense-allocations]');
            const addButton = document.querySelector('[data-add-expense-allocation]');
            const prototypeTemplate = document.querySelector('[data-expense-allocation-prototype]');
            if (!collection || !addButton || !prototypeTemplate) return;
            let index = collection.querySelectorAll('[data-expense-allocation]').length;
            addButton.addEventListener('click', function () {
                const markup = prototypeTemplate.innerHTML.replace(/__name__/g, index++);
                collection.insertAdjacentHTML('beforeend', markup);
            });
            collection.addEventListener('click', function (event) {
                const button = event.target.closest('[data-remove-expense-allocation]');
                if (button) {
                    button.closest('[data-expense-allocation]')?.remove();
                }
            });

            const amountField = document.querySelector('[name="expense_form[amount]"]');
            const currencyField = document.querySelector('[name="expense_form[currency]"]');
            const dateField = document.querySelector('[name="expense_form[expenseDate]"]');
            const previewBox = document.querySelector('[data-expense-currency-preview]');
            if (!amountField || !currencyField || !dateField || !previewBox) return;

            const previewUrl = previewBox.dataset.currencyPreviewUrl;
            const transLoading = previewBox.dataset.transLoading || '';
            const transConverted = previewBox.dataset.transConverted || '';
            const transUnavailable = previewBox.dataset.transUnavailable || '';
            const locale = document.documentElement.lang || 'es-CL';

            // Same locale-format -> ISO parsing as templates/quotation/edit.html.twig
            // (the expenseDate field carries the same data-format attribute,
            // set by the date_widget form theme block).
            const parseDateWithFormat = function (value, format) {
                if (!value || !format) return null;
                const formatParts = format.match(/[A-Za-z]+/g);
                const valueParts = value.match(/[0-9]+/g);
                if (!formatParts || !valueParts || formatParts.length !== valueParts.length) return null;
                let day = null, month = null, year = null;
                formatParts.forEach(function (token, i) {
                    const v = Number.parseInt(valueParts[i], 10);
                    if (token.charAt(0) === 'D') day = v;
                    else if (token.charAt(0) === 'M') month = v;
                    else if (token.charAt(0) === 'Y') year = v;
                });
                if (!day || !month || !year) return null;
                return String(year).padStart(4, '0') + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
            };

            const formatClpAmount = function (value) {
                return new Intl.NumberFormat(locale, {minimumFractionDigits: 0, maximumFractionDigits: 0}).format(Number.parseFloat(value));
            };

            const formatDate = function (isoDate) {
                const parsed = new Date(isoDate + 'T00:00:00');
                return Number.isNaN(parsed.getTime()) ? isoDate : parsed.toLocaleDateString(locale);
            };

            const setPreviewState = function (state, message) {
                previewBox.dataset.state = state;
                previewBox.classList.toggle('text-danger', state === 'unavailable');
                previewBox.classList.toggle('gp-workflow__status--positive', state === 'available');
                previewBox.classList.toggle('gp-workflow__status--danger', state === 'unavailable');
                previewBox.textContent = message;
            };
            const hidePreview = function () {
                setPreviewState('idle', '');
            };
            const showLoading = function () {
                setPreviewState('loading', transLoading);
            };
            const showConverted = function (clpAmount, rateDate) {
                setPreviewState('available', transConverted.replace('__AMOUNT__', formatClpAmount(clpAmount)).replace('__DATE__', formatDate(rateDate)));
            };
            const showUnavailable = function () {
                setPreviewState('unavailable', transUnavailable);
            };

            let requestToken = 0;
            const fetchPreview = function () {
                const token = ++requestToken;
                if (!previewUrl || currencyField.value === 'CLP') {
                    hidePreview();
                    return;
                }
                const amount = amountField.value;
                const isoDate = parseDateWithFormat(dateField.value, dateField.dataset.format);
                if (!amount || !isoDate) {
                    hidePreview();
                    return;
                }
                showLoading();
                const params = new URLSearchParams({amount: amount, currency: currencyField.value, date: isoDate});
                fetch(previewUrl + '?' + params.toString(), {headers: {'Accept': 'application/json'}})
                    .then(function (response) { return response.ok ? response.json() : {convertible: false}; })
                    .then(function (data) {
                        if (token !== requestToken) return;
                        if (data.convertible) {
                            showConverted(data.clpAmount, data.rateDate);
                        } else {
                            showUnavailable();
                        }
                    })
                    .catch(function () {
                        if (token !== requestToken) return;
                        showUnavailable();
                    });
            };

            let debounceTimer = null;
            const debouncedFetchPreview = function () {
                window.clearTimeout(debounceTimer);
                debounceTimer = window.setTimeout(fetchPreview, 350);
            };
            [amountField, currencyField, dateField].forEach(function (field) {
                field.addEventListener('input', debouncedFetchPreview);
                field.addEventListener('change', debouncedFetchPreview);
            });
            fetchPreview();
        });
    </script>
{% endblock %}
