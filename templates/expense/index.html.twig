{% extends 'base.html.twig' %}

{% import "expense/actions.html.twig" as actions %}

{% block main %}
        <div class="card gp-workflow gp-workflow--expense gp-workflow__surface">
            <div class="card-header gp-workflow__header">

            <h3 class="card-title">{{ 'expenses'|trans }}</h3>
            <div class="card-actions gp-workflow__actions">
                <a class="btn btn-primary" href="{{ path('expense_create') }}">{{ 'expense.create_title'|trans }}</a>
                <a class="btn btn-link" href="{{ path('expense_pending') }}">{{ 'expense.pending_title'|trans }}</a>
            </div>
        </div>
            {% if expenses|length > 0 %}
                <div class="table-responsive gp-workflow__table-scroll gp-workflow--expense__list-scroll">
                    <table class="table table-vcenter card-table gp-workflow__table">

                        <thead><tr><th>{{ 'description'|trans }}</th><th>{{ 'expense.amount'|trans }}</th><th>{{ 'date'|trans }}</th><th>{{ 'expense.category'|trans }}</th><th>{{ 'status'|trans }}</th><th></th></tr></thead>
                        <tbody>
                        {% for expense in expenses %}
                            {% set expense_row_url = is_granted('edit_expense', expense) ? path('expense_edit', {id: expense.id}) : path('expense_view', {id: expense.id}) %}
                            <tr class="alternative-link cursor-pointer gp-workflow--expense__row" data-href="{{ expense_row_url }}" data-gp-row-link tabindex="0" role="link" aria-label="{{ expense.description }}">
                                <td>{{ expense.description }}</td>
                                <td>{{ expense.amount|money(expense.currency) }}</td>
                                <td>{{ expense.expenseDate ? expense.expenseDate|date('Y-m-d') : '' }}</td>
                                <td>{{ expense.category ? ('expense.category.' ~ expense.category)|trans : 'expense.category_none'|trans }}</td>
                                <td><span class="gp-workflow__status gp-workflow--expense__status">{{ ('expense.status.' ~ expense.status)|trans }}</span></td>
                                <td class="text-end gp-workflow--expense__actions">{{ actions.expense(expense, 'index') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="card-body gp-workflow__empty-state gp-workflow-state gp-workflow-state--empty" data-gp-workflow-empty="expense-list">
                    {{ 'expense.none_found'|trans }}
                </div>
            {% endif %}
    </div>
{% endblock %}
