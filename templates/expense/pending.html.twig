{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">Pending my approval</h3></div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Description</th><th>Amount</th><th>Level</th><th></th></tr></thead>
                <tbody>
                {% for expense in expenses %}
                    <tr>
                        <td>{{ expense.description }}</td>
                        <td>{{ expense.amount }}</td>
                        <td>{{ expense.currentLevel + 1 }} / {{ expense.requiredLevels }}</td>
                        <td class="text-end"><a href="{{ path('expense_view', {id: expense.id}) }}">Review</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">No expenses are awaiting your approval.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
