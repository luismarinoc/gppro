{% extends 'base.html.twig' %}

{% block main %}
    <div class="card gp-workflow gp-workflow--expense gp-workflow__surface">
        <div class="card-header gp-workflow__header"><h3 class="card-title">{{ 'expense.pending_title'|trans }}</h3></div>
        {% if expenses|length > 0 %}
            <div class="table-responsive gp-workflow__table-scroll gp-workflow--expense__list-scroll">
                <table class="table table-vcenter card-table gp-workflow__table">
                    <thead><tr><th>{{ 'description'|trans }}</th><th>{{ 'expense.amount'|trans }}</th><th>{{ 'expense_approval_level.level'|trans }}</th><th></th></tr></thead>
                    <tbody>
                    {% for expense in expenses %}
                        {% set expense_row_url = path('expense_view', {id: expense.id}) %}
                        <tr class="alternative-link cursor-pointer gp-workflow--expense__row" data-href="{{ expense_row_url }}" data-gp-row-link tabindex="0" role="link" aria-label="{{ expense.description }}">
                <td>{{ expense.description }}</td>
                <td>{{ expense.amount|money(expense.currency) }}</td>
                <td><span class="gp-workflow__status gp-workflow__status--info">{{ expense.currentLevel + 1 }} / {{ expense.requiredLevels }}</span></td>
                <td class="text-end gp-workflow--expense__actions"><a href="{{ expense_row_url }}">{{ 'expense.review'|trans }}</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="card-body gp-workflow__empty-state gp-workflow-state gp-workflow-state--empty" data-gp-workflow-empty="expense-pending">
                {{ 'expense.none_pending'|trans }}
            </div>
        {% endif %}
    </div>
{% endblock %}
