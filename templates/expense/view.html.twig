{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ expense.description }}</h3>
            <div class="card-actions">
                {% if expense.editable %}
                    <a class="btn btn-link" href="{{ path('expense_edit', {id: expense.id}) }}">Edit</a>
                    <form class="d-inline" method="post" action="{{ path('expense_submit', {id: expense.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('expense_submit_' ~ expense.id) }}">
                        <button class="btn btn-primary" type="submit">Submit for approval</button>
                    </form>
                {% endif %}
                {% if expense.status in ['draft', 'rejected'] %}
                    <form class="d-inline" method="post" action="{{ path('expense_delete', {id: expense.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('expense_delete_' ~ expense.id) }}">
                        <button class="btn btn-link text-danger" type="submit">Delete</button>
                    </form>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            <p>Amount: {{ expense.amount }}</p>
            <p>Date: {{ expense.expenseDate ? expense.expenseDate|date('Y-m-d') : '' }}</p>
            <p>Status: {{ expense.status }}</p>
            {% if expense.requiredLevels is not null %}
                <p>Approval progress: {{ expense.currentLevel }} / {{ expense.requiredLevels }}</p>
            {% endif %}

            <table class="table table-vcenter card-table">
                <thead><tr><th>Project</th><th>Percentage</th><th>Amount</th><th>Charged</th><th></th></tr></thead>
                <tbody>
                {% for allocation in expense.allocations %}
                    <tr>
                        <td>{{ allocation.project ? allocation.project.name : '' }}</td>
                        <td>{{ allocation.percentage }}%</td>
                        <td>{{ allocation.amountClp }}</td>
                        <td>{{ allocation.charged ? 'Yes' : 'No' }}</td>
                        <td>
                            {% if charge_forms[allocation.id] is defined %}
                                {{ form_start(charge_forms[allocation.id]) }}
                                {{ form_widget(charge_forms[allocation.id]) }}
                                <button class="btn btn-sm btn-primary" type="submit">Charge</button>
                                {{ form_end(charge_forms[allocation.id]) }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if expense.nextPendingLevel %}
        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title">Decision</h3></div>
            <div class="card-body">
                <form method="post" action="{{ path('expense_approve', {id: expense.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('expense_approval_decision') }}">
                    <textarea name="expense_approval_decision_form[note]" placeholder="Optional note"></textarea>
                    <button class="btn btn-primary" type="submit">Approve</button>
                </form>
                <form method="post" action="{{ path('expense_reject', {id: expense.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('expense_approval_decision') }}">
                    <textarea name="expense_approval_decision_form[note]" placeholder="Optional note"></textarea>
                    <button class="btn btn-danger" type="submit">Reject</button>
                </form>
            </div>
        </div>
    {% endif %}
{% endblock %}
