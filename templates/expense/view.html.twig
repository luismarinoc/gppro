{% extends 'base.html.twig' %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ expense.description }}</h3>
            <div class="card-actions">
                {% if expense.editable %}
                    <a class="btn btn-link" href="{{ path('expense_edit', {id: expense.id}) }}">{{ 'action.edit'|trans }}</a>
                    <form class="d-inline" method="post" action="{{ path('expense_submit', {id: expense.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('expense_submit_' ~ expense.id) }}">
                        <button class="btn btn-primary" type="submit">{{ 'expense.submit'|trans }}</button>
                    </form>
                {% endif %}
                {% if expense.status in ['draft', 'rejected'] %}
                    <form class="d-inline" method="post" action="{{ path('expense_delete', {id: expense.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('expense_delete_' ~ expense.id) }}">
                        <button class="btn btn-link text-danger" type="submit">{{ 'delete'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            <p>{{ 'expense.amount'|trans }}: {{ expense.amount|money(expense.currency) }}</p>
            <p>{{ 'date'|trans }}: {{ expense.expenseDate ? expense.expenseDate|date('Y-m-d') : '' }}</p>
            <p>{{ 'expense.category'|trans }}: {{ expense.category ? ('expense.category.' ~ expense.category)|trans : 'expense.category_none'|trans }}</p>
            <p>{{ 'status'|trans }}: {{ ('expense.status.' ~ expense.status)|trans }}</p>
            {% if expense.requiredLevels is not null %}
                <p>{{ 'expense.approval_progress'|trans }}: {{ expense.currentLevel }} / {{ expense.requiredLevels }}</p>
            {% endif %}

            <table class="table table-vcenter card-table">
                <thead><tr><th>{{ 'expense.allocation_project'|trans }}</th><th>{{ 'expense.allocation_percentage'|trans }}</th><th>{{ 'expense.amount'|trans }}</th><th>{{ 'expense.charged'|trans }}</th><th></th></tr></thead>
                <tbody>
                {% for allocation in expense.allocations %}
                    <tr>
                        <td>{{ allocation.project ? allocation.project.name : '' }}</td>
                        <td>{{ allocation.percentage }}%</td>
                        <td>{{ allocation.amountClp|money('CLP') }}</td>
                        <td>{{ (allocation.charged ? 'yes' : 'no')|trans }}</td>
                        <td>
                            {% if charge_forms[allocation.id] is defined %}
                                {{ form_start(charge_forms[allocation.id]) }}
                                {{ form_widget(charge_forms[allocation.id]) }}
                                <button class="btn btn-sm btn-primary" type="submit">{{ 'expense.charge_action'|trans }}</button>
                                {{ form_end(charge_forms[allocation.id]) }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if is_granted('approve_expense', expense) or is_granted('reject_expense', expense) %}
        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title">{{ 'expense.decision'|trans }}</h3></div>
            <div class="card-body">
                {% if is_granted('approve_expense', expense) %}
                    <form method="post" action="{{ path('expense_approve', {id: expense.id}) }}">
                        <input type="hidden" name="expense_approval_decision_form[_token]" value="{{ csrf_token('expense_approval_decision') }}">
                        <textarea name="expense_approval_decision_form[note]" placeholder="{{ 'expense.note_placeholder'|trans }}"></textarea>
                        <button class="btn btn-primary" type="submit">{{ 'approve'|trans }}</button>
                    </form>
                {% endif %}
                {% if is_granted('reject_expense', expense) %}
                    <form method="post" action="{{ path('expense_reject', {id: expense.id}) }}">
                        <input type="hidden" name="expense_approval_decision_form[_token]" value="{{ csrf_token('expense_approval_decision') }}">
                        <textarea name="expense_approval_decision_form[note]" placeholder="{{ 'expense.note_placeholder'|trans }}"></textarea>
                        <button class="btn btn-danger" type="submit">{{ 'reject'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
