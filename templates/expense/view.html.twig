{% extends 'base.html.twig' %}

{% block main %}
    <div class="card gp-workflow gp-workflow--expense gp-workflow__surface">
        <div class="card-header gp-workflow__header">
            <h3 class="card-title">{{ expense.description }}</h3>
            <div class="card-actions gp-workflow__actions">
                {% if expense.editable %}
                    <a class="btn btn-link" href="{{ path('expense_edit', {id: expense.id}) }}">{{ 'action.edit'|trans }}</a>
                    <form class="d-inline" method="post" action="{{ path('expense_submit', {id: expense.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('expense_submit_' ~ expense.id) }}">
                        <button class="btn btn-primary" type="submit">{{ 'expense.submit'|trans }}</button>
                    </form>
                {% endif %}
                {% if expense.status in ['draft', 'rejected'] %}
                    <form class="d-inline" method="post" action="{{ path('expense_delete', {id: expense.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('expense_delete_' ~ expense.id) }}">
                        <button class="btn btn-link text-danger" type="submit">{{ 'delete'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            <dl class="gp-workflow--expense__details">
                <div><dt>{{ 'expense.amount'|trans }}</dt><dd>{{ expense.amount|money(expense.currency) }}</dd></div>
                <div><dt>{{ 'date'|trans }}</dt><dd>{{ expense.expenseDate ? expense.expenseDate|date('Y-m-d') : '' }}</dd></div>
                <div><dt>{{ 'expense.category'|trans }}</dt><dd>{{ expense.category ? ('expense.category.' ~ expense.category)|trans : 'expense.category_none'|trans }}</dd></div>
                <div><dt>{{ 'status'|trans }}</dt><dd><span class="gp-workflow__status gp-workflow--expense__status">{{ ('expense.status.' ~ expense.status)|trans }}</span></dd></div>
                {% if expense.requiredLevels is not null %}
                    <div><dt>{{ 'expense.approval_progress'|trans }}</dt><dd>{{ expense.currentLevel }} / {{ expense.requiredLevels }}</dd></div>
                {% endif %}
            </dl>

            <div class="table-responsive gp-workflow__table-scroll gp-workflow--expense__allocations-table">
            <table class="table table-vcenter card-table gp-workflow__table">
                <thead><tr><th>{{ 'expense.allocation_project'|trans }}</th><th>{{ 'expense.allocation_percentage'|trans }}</th><th>{{ 'expense.amount'|trans }}</th><th>{{ 'expense.charged'|trans }}</th><th></th></tr></thead>
                <tbody>
                {% for allocation in expense.allocations %}
                    <tr>
                        <td>{{ allocation.project ? allocation.project.name : '' }}</td>
                        <td>{{ allocation.percentage }}%</td>
                        <td>{{ allocation.amountClp|money('CLP') }}</td>
                        <td>{{ (allocation.charged ? 'yes' : 'no')|trans }}</td>
                        <td>
                            {% if charge_forms[allocation.id] is defined %}
                                {{ form_start(charge_forms[allocation.id]) }}
                                {{ form_widget(charge_forms[allocation.id]) }}
                                <button class="btn btn-sm btn-primary" type="submit">{{ 'expense.charge_action'|trans }}</button>
                                {{ form_end(charge_forms[allocation.id]) }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    </div>

    {% if is_granted('approve_expense', expense) or is_granted('reject_expense', expense) %}
        <div class="card mt-3 gp-workflow__section gp-workflow__surface gp-workflow--expense__decision">
            <div class="card-header gp-workflow__header"><h3 class="card-title">{{ 'expense.decision'|trans }}</h3></div>
            <div class="card-body gp-workflow--expense__decision-grid">
                {% if is_granted('approve_expense', expense) %}
                    <form class="gp-workflow--expense__decision-form" method="post" action="{{ path('expense_approve', {id: expense.id}) }}">
                        <input type="hidden" name="expense_approval_decision_form[_token]" value="{{ csrf_token('expense_approval_decision') }}">
                        <label class="form-label" for="expense-approve-note-{{ expense.id }}">{{ 'expense.note_placeholder'|trans }}</label>
                        <textarea class="form-control" id="expense-approve-note-{{ expense.id }}" name="expense_approval_decision_form[note]" placeholder="{{ 'expense.note_placeholder'|trans }}"></textarea>
                        <button class="btn btn-primary mt-2" type="submit">{{ 'approve'|trans }}</button>
                    </form>
                {% endif %}
                {% if is_granted('reject_expense', expense) %}
                    <form class="gp-workflow--expense__decision-form" method="post" action="{{ path('expense_reject', {id: expense.id}) }}">
                        <input type="hidden" name="expense_approval_decision_form[_token]" value="{{ csrf_token('expense_approval_decision') }}">
                        <label class="form-label" for="expense-reject-note-{{ expense.id }}">{{ 'expense.note_placeholder'|trans }}</label>
                        <textarea class="form-control" id="expense-reject-note-{{ expense.id }}" name="expense_approval_decision_form[note]" placeholder="{{ 'expense.note_placeholder'|trans }}"></textarea>
                        <button class="btn btn-danger mt-2" type="submit">{{ 'reject'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
