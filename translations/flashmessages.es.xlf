<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="es" datatype="plaintext" original="flashmessages.en.xlf">
    <body>
      <trans-unit id="S9k1S7Z" resname="warning">
        <source>warning</source>
        <target>Atención</target>
      </trans-unit>
      <trans-unit id="WmrEP_5" resname="timesheet.stop.success" xml:space="preserve">
        <source>timesheet.stop.success</source>
        <target state="translated">El registro de hora ha sido detenido</target>
      </trans-unit>
      <trans-unit id="NPBnpK_" resname="timesheet.stop.error">
        <source>timesheet.stop.error</source>
        <target>No se pudo detener el registro del tiempo</target>
      </trans-unit>
      <trans-unit id="CCUoZga" resname="timesheet.start.success">
        <source>timesheet.start.success</source>
        <target>Registro de tiempo iniciado</target>
      </trans-unit>
      <trans-unit id="3w9tuox" resname="timesheet.start.error">
        <source>timesheet.start.error</source>
        <target>No se pudo iniciar el registro de tiempo</target>
      </trans-unit>
      <trans-unit id="kPINWEK" resname="timesheet.locked.warning">
        <source>timesheet.locked.warning</source>
        <target>Está editando un registro exportado</target>
      </trans-unit>
      <trans-unit id="72Ih8zO" resname="action.update.success">
        <source>action.update.success</source>
        <target>Cambios guardados</target>
      </trans-unit>
      <trans-unit id="xeu1LSy" resname="action.update.error">
        <source>action.update.error</source>
        <target>No se pudieron guardar los cambios: %reason%</target>
      </trans-unit>
      <trans-unit id="YV50HDB" resname="action.delete.success">
        <source>action.delete.success</source>
        <target>Registro eliminado</target>
      </trans-unit>
      <trans-unit id="mW91Tmb" resname="action.delete.error">
        <source>action.delete.error</source>
        <target>No se pudo eliminar el registro: %reason%</target>
      </trans-unit>
      <trans-unit id="B_cz49z" resname="invoice.first_template">
        <source>invoice.first_template</source>
        <target>Debe crear una plantilla de factura primero</target>
      </trans-unit>
      <trans-unit id="wejAEcR" resname="action.upload.error">
        <source>action.upload.error</source>
        <target>No se pudo cargar ni guardar el archivo: %reason%</target>
      </trans-unit>
      <trans-unit resname="action.csrf.error" id="bOE_q5R">
        <source>action.csrf.error</source>
        <target state="translated">La acción no puede realizarse: el token de seguridad no es válido.</target>
      </trans-unit>
      <trans-unit id="gpMsInvE1" resname="milestone_invoice.error.mixed_customer" xml:space="preserve">
        <source>milestone_invoice.error.mixed_customer</source>
        <target state="translated">Los hitos seleccionados deben pertenecer todos al mismo cliente.</target>
      </trans-unit>
      <trans-unit id="gpMsInvE2" resname="milestone_invoice.error.empty_selection" xml:space="preserve">
        <source>milestone_invoice.error.empty_selection</source>
        <target state="translated">Por favor selecciona al menos un hito para facturar.</target>
      </trans-unit>
      <trans-unit id="gpMsInvE3" resname="milestone_invoice.error.stale_selection" xml:space="preserve">
        <source>milestone_invoice.error.stale_selection</source>
        <target state="translated">Uno de los hitos seleccionados ya fue facturado o ya no se puede convertir. Recarga la lista e intenta nuevamente.</target>
      </trans-unit>
      <trans-unit id="gpMsInvE4" resname="milestone_invoice.error.unauthorized_customer" xml:space="preserve">
        <source>milestone_invoice.error.unauthorized_customer</source>
        <target state="translated">Los hitos seleccionados no pertenecen a un cliente para el cual tienes autorización de facturación.</target>
      </trans-unit>
      <trans-unit id="gpMsInvE5" resname="milestone_invoice.error.no_hours_logged" xml:space="preserve">
        <source>milestone_invoice.error.no_hours_logged</source>
        <target state="translated">Uno de los hitos seleccionados no tiene horas facturables cargadas todavía y no se puede facturar.</target>
      </trans-unit>
      <trans-unit id="quotationSendSuccess" resname="quotation.send.success" xml:space="preserve">
        <source>quotation.send.success</source>
        <target state="translated">Cotización enviada correctamente.</target>
      </trans-unit>
      <trans-unit id="quotationConvertSuccess" resname="quotation.convert.success" xml:space="preserve">
        <source>quotation.convert.success</source>
        <target state="translated">La cotización se convirtió en factura.</target>
      </trans-unit>
      <trans-unit id="quotationConvertError" resname="quotation.convert.error" xml:space="preserve">
        <source>quotation.convert.error</source>
        <target state="translated">No se pudo convertir la cotización: %reason%</target>
      </trans-unit>
    </body>
  </file>
</xliff>
